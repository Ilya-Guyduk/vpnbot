[Unit]
Description=Bore TCP tunnel — xray test (NAT bypass)
After=network-online.target xray.service
Wants=network-online.target
Requires=xray.service

[Service]
Type=simple
{% if xray_tunnel_port | int > 0 %}
ExecStart=/usr/local/bin/bore local {{ xray_port }} --local-host {{ ansible_default_ipv4.address }} --to bore.pub --port {{ xray_tunnel_port }}
{% else %}
ExecStart=/usr/local/bin/bore local {{ xray_port }} --local-host {{ ansible_default_ipv4.address }} --to bore.pub
{% endif %}
Restart=on-failure
RestartSec=10s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=bore-tunnel

[Install]
WantedBy=multi-user.target